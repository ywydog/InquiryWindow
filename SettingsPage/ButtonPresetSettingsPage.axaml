<ci:SettingsPageBase x:Class="InquiryWindow.SettingsPage.ButtonPresetSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:vm="clr-namespace:InquiryWindow.ViewModels"
                     xmlns:models="clr-namespace:InquiryWindow.Models"
                     d:DesignHeight="450" d:DesignWidth="800"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     x:DataType="vm:ButtonPresetSettingsViewModel"
                     mc:Ignorable="d">

    <!--
        设计理念借鉴自 SuperAutoIsland 「可复用行动组」(AutomationSettingsPage)：
        - 左侧：标题 + 「新建」入口 + 预设列表（点击高亮选中）。
        - 右侧：详情区（Emptiable 在未选中时显示引导提示）。
        与 SystemTools 多页面注册风格保持一致：在 Plugin.cs 里以 settings page 形式注册。
    -->

    <Grid ColumnDefinitions="280,*" Margin="0,0,8,0">

        <!-- ========== 左栏：列表 ========== -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" Margin="0,0,0,0">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,0" Spacing="6">
                <ci:FluentIcon Glyph="&#xE82D;" FontSize="20"
                               VerticalAlignment="Center" />
                <TextBlock Text="按钮预设库"
                           Theme="{StaticResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Margin="16,2,12,8"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Text="在此集中管理按钮预设。预设可被多按钮询问的按钮通过「从预设插入」引用，插入后该按钮拥有独立的 Action 链副本。" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,8" Spacing="6">
                <Button Command="{Binding AddPresetCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ci:FluentIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="新建预设" />
                    </StackPanel>
                </Button>
                <Button Content="删除"
                        Command="{Binding RemovePresetCommand}"
                        IsEnabled="{Binding SelectedPreset, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <ListBox Grid.Row="3"
                     x:Name="PresetsListBox"
                     ItemsSource="{Binding Presets}"
                     SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                     Background="Transparent"
                     Margin="4,0,4,0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ButtonPreset">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="6" ColumnSpacing="10">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Icon}"
                                       FontFamily="{DynamicResource FluentIcons}"
                                       FontSize="18"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Actions.ActionItems.Count, StringFormat={}{0} 个 Action}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ========== 右栏：详情 ========== -->
        <Border Grid.Column="1"
                Margin="8,12,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ci:Emptiable Content="{Binding SelectedPreset}">
                <ci:Emptiable.EmptyContent>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <ci:FluentIcon Glyph="&#xE8B7;" FontSize="48"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                        <TextBlock Text="在左侧选择或新建一个按钮预设"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ci:Emptiable.EmptyContent>
                <ci:Emptiable.ContentTemplate>
                    <DataTemplate x:DataType="models:ButtonPreset">
                        <ScrollViewer>
                            <StackPanel Spacing="14" Margin="20,16,20,16">

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ci:FluentIcon Glyph="&#xE82D;" FontSize="20" />
                                    <TextBlock Text="预设详情"
                                               Theme="{StaticResource SubtitleTextBlockStyle}" />
                                </StackPanel>

                                <!-- 名称 -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="名称" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <!-- 图标 -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="图标（Fluent SystemIcons）" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Icon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource FluentIcons}" />
                                        <Button Grid.Column="1"
                                                Content="选择图标…"
                                                Click="OnPickIconClick" />
                                    </Grid>
                                </StackPanel>

                                <!-- Action 链 -->
                                <Expander Header="Action 链"
                                          IsExpanded="True">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="本预设引用的 Action 序列。多按钮询问中插入此预设时，链会被复制成独立副本。"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Button Content="编辑 Action 链…"
                                                Click="OnEditActionsClick"
                                                HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>
                </ci:Emptiable.ContentTemplate>
            </ci:Emptiable>
        </Border>

    </Grid>
</ci:SettingsPageBase>
