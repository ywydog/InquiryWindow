<ci:SettingsPageBase x:Class="InquiryWindow.SettingsPage.InquiryWindowSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:vm="clr-namespace:InquiryWindow.ViewModels"
                     xmlns:local="clr-namespace:InquiryWindow.Controls"
                     d:DesignHeight="450" d:DesignWidth="800"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     x:DataType="vm:InquiryWindowSettingsViewModel"
                     mc:Ignorable="d">

    <ci:SettingsPageBase.Styles>
        <!-- 引入设置页懒加载容器的模板样式 -->
        <StyleInclude Source="avares://InquiryWindow/Controls/SettingsPageLazy.axaml" />
    </ci:SettingsPageBase.Styles>

    <!--
        Android 兼容说明（new/for-android-2.2 分支专用）：
        此页面只保留"插件级全局设置"占位说明，弹窗外观/亚克力背景等桌面端专有
        设置已移除（WindowTransparencyLevel.AcrylicBlur 在 Android 上不支持）。
        按钮预设库已拆为独立页面 (ButtonPresetSettingsPage)，注册在 Plugin.cs。
    -->

    <!-- 懒加载：打开设置页时先显示加载指示器，内容延迟淡入，避免页面切换卡顿。 -->
    <local:SettingsPageLazy>
    <ScrollViewer>
        <StackPanel Classes="settings-container" Spacing="10">

            <Label FontSize="20"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                InquiryWindow
            </Label>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ci:FluentIcon FontSize="56"
                               Glyph="&#xE82D;"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                <Label VerticalAlignment="Center" FontSize="28">询问窗设置</Label>
            </StackPanel>

            <TextBlock Text="弹窗的全局行为与外观。按钮预设库已拆为独立页面（见左侧设置列表）。"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="13" />

            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE7B3;}"
                                       Header="弹窗外观"
                                       Description="当前 Android 版本下无可配置项。桌面端的亚克力背景等功能仅在 Windows 平台提供。">
                <TextBlock Text="在 Android 上，弹窗外观使用系统默认样式。"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0" />
            </controls:FASettingsExpander>

        </StackPanel>
    </ScrollViewer>
    </local:SettingsPageLazy>
</ci:SettingsPageBase>
