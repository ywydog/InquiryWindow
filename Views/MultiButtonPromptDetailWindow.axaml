<ci:MyWindow x:Class="InquiryWindow.Views.MultiButtonPromptDetailWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ci="http://classisland.tech/schemas/xaml/core"
                 xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                 xmlns:core="clr-namespace:ClassIsland.Core.Controls.Automation;assembly=ClassIsland.Core"
                 xmlns:models="clr-namespace:InquiryWindow.Models"
                 xmlns:local="clr-namespace:InquiryWindow.Views"
                 x:DataType="local:MultiButtonPromptDetailWindow"
                 Title="多按钮询问行动 · 详细设置"
                 Width="1240" Height="550"
                 MinWidth="720" MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 CanResize="True"
                 ShowAsDialog="True">

    <ci:MyWindow.Styles>
        <StyleInclude Source="avares://ClassIsland.Core/Themes/RichTextStyles.axaml" />

        <!-- 左侧设置卡（与设计稿"section"对应） -->
        <Style Selector="Border.pane-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="TextBlock.pane-card-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 工具栏按钮风格 -->
        <Style Selector="Button.toolbar-btn" xmlns="https://github.com/avaloniaui">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.toolbar-btn.accent">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

        <!-- 按钮行：列表项容器 -->
        <Style Selector="Border.button-row" xmlns="https://github.com/avaloniaui">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <!-- 拖拽手柄：⋮⋮ 区域 -->
        <Style Selector="Border.drag-grip" xmlns="https://github.com/avaloniaui">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.drag-grip:pointerover" xmlns="https://github.com/avaloniaui">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
    </ci:MyWindow.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ============ 标题栏（OS 风格）============ -->
        <Border Grid.Row="0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                Padding="12,8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <ci:FluentIcon Glyph="&#xE82D;"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="多按钮询问行动 · 详细设置"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2" Classes="toolbar-btn" Click="OnPreviewClick" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ci:FluentIcon Glyph="&#xE890;" FontSize="13" />
                        <TextBlock Text="预览弹窗" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Classes="toolbar-btn" Click="OnCancelClick" Margin="0,0,6,0">
                    <TextBlock Text="取消" />
                </Button>
                <Button Grid.Column="4" Classes="toolbar-btn accent" Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ci:FluentIcon Glyph="&#xE74E;" FontSize="13" />
                        <TextBlock Text="保存" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============ 主体：三栏布局 ============ -->
        <Grid Grid.Row="2" ColumnDefinitions="320,280,*">

            <!-- ======== 左侧：窗口设置 ======== -->
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12,10,12,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ci:FluentIcon Glyph="&#xE8A7;" FontSize="14"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="窗口设置"
                                       FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Padding="10">
                        <StackPanel Spacing="10" x:Name="LeftPane">

                            <!-- 弹窗基础信息 -->
                            <Border Classes="pane-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="弹窗基础" Classes="pane-card-title" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="标题" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{Binding Settings.Title, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="主提示（Markdown）" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{Binding Settings.Prompt, Mode=TwoWay}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="副提示（可空）" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{Binding Settings.SubPrompt, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="弹窗图标" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                            <Border Grid.Column="0" Width="28" Height="28"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                <ci:FluentIcon Glyph="{Binding Settings.Icon}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                            </Border>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Settings.Icon, Mode=TwoWay}" />
                                            <Button Grid.Column="2" Content="…"
                                                    Click="OnPickWindowIconClick" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 倒计时 / 自动执行 -->
                            <Border Classes="pane-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="倒计时 / 自动执行" Classes="pane-card-title" />
                                    <CheckBox x:Name="CountdownEnabledCheck"
                                              Content="启用倒计时（到时按指定按钮自动执行）"
                                              IsChecked="{Binding Settings.IsAutoExecuteEnabled, Mode=TwoWay}" />
                                    <StackPanel Spacing="8"
                                                IsEnabled="{Binding #CountdownEnabledCheck.IsChecked}">
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                                <TextBlock Text="时长（秒）" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <controls:FANumberBox Minimum="0" Maximum="3600"
                                                                       SmallChange="1" LargeChange="5"
                                                                       Value="{Binding Settings.AutoExecuteSeconds, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                                <TextBlock Text="进度条样式" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ComboBox x:Name="CountdownBarStyleBox" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="线性条（主提示下方）" Tag="line" />
                                                    <ComboBoxItem Content="环形" Tag="circle" />
                                                    <ComboBoxItem Content="隐藏" Tag="none" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="自动执行的按钮" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ComboBox HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding Settings.AutoExecuteTargets}"
                                                      SelectedIndex="{Binding Settings.AutoExecuteTargetIndex, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:AutoExecuteTarget">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="末尾「无事发生」表示到时间仅关闭弹窗、不执行任何 Action。"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 窗口关闭 -->
                            <Border Classes="pane-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="窗口关闭" Classes="pane-card-title" />
                                    <CheckBox x:Name="ClosableCheck"
                                              Content="窗口可直接关闭（显示 X 按钮）"
                                              IsChecked="{Binding Settings.IsClosable, Mode=TwoWay}" />
                                    <StackPanel Spacing="4" Margin="24,0,0,0"
                                                IsEnabled="{Binding #ClosableCheck.IsChecked}">
                                        <TextBlock Text="关闭时执行的按钮（与倒计时共用 AutoExecuteTargetIndex）"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Settings.AutoExecuteTargets}"
                                                  SelectedIndex="{Binding Settings.AutoExecuteTargetIndex, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:AutoExecuteTarget">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="点 X 关闭时按此按钮触发 Action 链。选择「无事发生」则仅关闭弹窗。"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 弹窗行为 -->
                            <Border Classes="pane-card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="弹窗行为" Classes="pane-card-title" />
                                    <CheckBox Content="置顶（弹窗始终位于最上层）"
                                              IsChecked="{Binding Settings.IsTopmost, Mode=TwoWay}" />
                                    <CheckBox Content="所有 Markdown 渲染"
                                              IsChecked="{Binding Settings.IsMarkdownRendered, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ======== 中间：按钮列表 ======== -->
            <Border Grid.Column="1"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12,10,12,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <ci:FluentIcon Glyph="&#xE8C8;" FontSize="14"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="按钮列表"
                                           FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       x:Name="ButtonCountLabel"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="10,8">
                        <TextBox x:Name="SearchBox" Watermark="搜索按钮名..."
                                 TextChanged="OnSearchTextChanged" />
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="10,8"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Classes="toolbar-btn"
                                    Click="OnAddButtonClick" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ci:FluentIcon Glyph="&#xE710;" FontSize="13" />
                                    <TextBlock Text="新建按钮" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="ButtonList"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="OnButtonListSelectionChanged"
                             DragDrop.AllowDrop="True"
                             DragDrop.DragOver="OnButtonListDragOver"
                             DragDrop.Drop="OnButtonListDrop">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:MultiButtonPromptButton">
                                <Border Classes="button-row"
                                        Tag="{Binding}"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragOver="OnButtonItemDragOver"
                                        DragDrop.Drop="OnButtonItemDrop">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                   FontFamily="{DynamicResource FluentIcons}"
                                                   FontSize="14" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Classes="drag-grip"
                                                Tag="{Binding}"
                                                PointerPressed="OnButtonDragHandlePressed"
                                                PointerMoved="OnButtonDragHandleMoved"
                                                PointerReleased="OnButtonDragHandleReleased"
                                                ToolTip.Tip="按住拖动以排序">
                                            <TextBlock Text="⋮⋮"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Actions.ActionItems.Count, StringFormat={}{0} actions}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ======== 右侧：按钮详情面板 ======== -->
            <DockPanel Grid.Column="2">
                <!-- 空状态 -->
                <Grid x:Name="PlaceholderView"
                      DockPanel.Dock="Top"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <ci:FluentIcon Glyph="&#xE8A1;" FontSize="42"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                        <TextBlock Text="从中间选择一个按钮" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="或在中间底部「+ 新建按钮」" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 详情表单 -->
                <ScrollViewer x:Name="DetailView" IsVisible="False" Padding="16">
                    <StackPanel Spacing="12">
                        <Border Classes="pane-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="按钮基础信息" Classes="pane-card-title" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <TextBox Grid.Row="0" Grid.Column="0"
                                             Watermark="按钮名称"
                                             Text="{Binding ActiveButton.Name, Mode=TwoWay}" />
                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                Orientation="Horizontal" Spacing="4" Margin="6,0,0,0">
                                        <TextBox Width="64" Watermark="图标"
                                                 Text="{Binding ActiveButton.Icon, Mode=TwoWay}" />
                                        <Button Content="…" Click="OnPickIconClick"
                                                ToolTip.Tip="从 Fluent 图标库选择" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="pane-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Action 链（按下按钮后依次执行）" Classes="pane-card-title" />
                                <core:ActionControl ActionSet="{Binding ActiveButton.Actions}" />
                            </StackPanel>
                        </Border>

                        <Button Classes="toolbar-btn"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                HorizontalAlignment="Right"
                                Click="OnDeleteButtonClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ci:FluentIcon Glyph="&#xE74D;" FontSize="13" />
                                <TextBlock Text="删除该按钮" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="3"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="InquiryWindow · v0.x.x"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</ci:MyWindow>
