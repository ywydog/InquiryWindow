<ci:MyWindow x:Class="InquiryWindow.Views.MultiButtonPromptDetailWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ci="http://classisland.tech/schemas/xaml/core"
                 xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                 xmlns:core="clr-namespace:ClassIsland.Core.Controls.Automation;assembly=ClassIsland.Core"
                 xmlns:models="clr-namespace:InquiryWindow.Models"
                 xmlns:icons="clr-namespace:ClassIsland.Core.Icons;assembly=ClassIsland.Core"
                 xmlns:converters="clr-namespace:InquiryWindow.Converters"
                 xmlns:local="clr-namespace:InquiryWindow.Views"
                 xmlns:ui="clr-namespace:InquiryWindow.Controls"
                 x:DataType="local:MultiButtonPromptDetailWindow"
                 Title="多按钮询问行动 · 详细设置"
                 Width="1240" Height="550"
                 MinWidth="1024" MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 CanResize="True"
                 ShowAsDialog="True">

    <ci:MyWindow.Styles>
        <StyleInclude Source="avares://ClassIsland.Core/Themes/RichTextStyles.axaml" />

        <!-- 左侧设置卡（与设计稿"section"对应） -->
        <Style Selector="Border.pane-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="TextBlock.pane-card-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 工具栏按钮风格 -->
        <Style Selector="Button.toolbar-btn">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.toolbar-btn.accent">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

        <!-- 按钮行：列表项容器 -->
        <Style Selector="Border.button-row">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <!-- 拖拽手柄：⋮⋮ 区域 -->
        <Style Selector="Border.drag-grip">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.drag-grip:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
    </ci:MyWindow.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ 标题栏（OS 风格）============ -->
        <Border Grid.Row="0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                Padding="12,8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <ci:FluentIcon Glyph="{x:Static icons:FluentIcons.ChatMultipleRegular}"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="多按钮询问行动 · 详细设置"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2" Classes="toolbar-btn" Click="OnPreviewClick" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ci:FluentIcon Glyph="{x:Static icons:FluentIcons.EyeRegular}" FontSize="13" />
                        <TextBlock Text="预览弹窗" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Classes="toolbar-btn" Click="OnCancelClick" Margin="0,0,6,0">
                    <TextBlock Text="取消" />
                </Button>
                <Button Grid.Column="4" Classes="toolbar-btn accent" Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ci:FluentIcon Glyph="{x:Static icons:FluentIcons.SaveRegular}" FontSize="13" />
                        <TextBlock Text="保存" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============ 主体：三栏布局 ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="320,280,*">

            <!-- ======== 左侧：窗口设置 ======== -->
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12,10,12,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ci:FluentIcon Glyph="{x:Static icons:FluentIcons.WindowRegular}" FontSize="14"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="窗口设置"
                                       FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Padding="10">
                        <StackPanel Spacing="10" x:Name="LeftPane">

                            <!-- 弹窗基础信息 -->
                            <Border Classes="pane-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="弹窗基础" Classes="pane-card-title" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="标题" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{Binding Settings.Title, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="主提示（Markdown）" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{Binding Settings.Prompt, Mode=TwoWay}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="副提示（可空）" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{Binding Settings.SubPrompt, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="弹窗图标" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="28" Height="28"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                <controls:FAIconSourceElement IconSource="{Binding WindowIconSource}"
                                                                              Width="14" Height="14"
                                                                              Classes="repair-fontsize"
                                                                              TextElement.FontSize="14"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                            </Border>
                                            <ui:IconExpressionEditor Grid.Column="1"
                                                                     Margin="6,0,0,0"
                                                                     VerticalAlignment="Center"
                                                                     IconExpression="{Binding WindowIcon, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 窗口背景：默认折叠（Expander） -->
                            <Expander HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ci:FluentIcon Glyph="{x:Static icons:FluentIcons.ColorBackgroundRegular}" FontSize="14"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Text="窗口背景" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Expander.Header>
                                <Border Classes="pane-card" Margin="0,8,0,0">
                                    <StackPanel Spacing="8">
                                        <!-- 缩略图预览（绑定到 Settings.BackgroundImagePath） -->
                                        <Border Height="80" ClipToBounds="True"
                                                CornerRadius="4"
                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                            <Panel>
                                                <TextBlock Text="无背景（使用纯色背景）"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding Settings.BackgroundImagePath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                                <Image Source="{Binding BackgroundPreview}"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding HasBackgroundPreview}" />
                                            </Panel>
                                        </Border>

                                        <!-- 路径 + 浏览 + 清除 -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="图片路径" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding Settings.BackgroundImagePath, Mode=TwoWay}" />
                                                <Button Grid.Column="1" Content="浏览…"
                                                        Margin="6,0,6,0"
                                                        Click="OnBrowseBackgroundImageClick" />
                                                <Button Grid.Column="2" Content="✕"
                                                        ToolTip.Tip="清除背景"
                                                        Click="OnClearBackgroundImageClick" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- 缩放方式 -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="缩放方式" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ComboBox HorizontalAlignment="Stretch"
                                                      SelectedIndex="{Binding Settings.BackgroundImageMode, Mode=TwoWay}">
                                                <ComboBoxItem Content="覆盖（保持比例，超出裁剪）" />
                                                <ComboBoxItem Content="包含（保持比例，留白）" />
                                                <ComboBoxItem Content="拉伸（填满，可能变形）" />
                                                <ComboBoxItem Content="平铺（重复铺满）" />
                                            </ComboBox>
                                        </StackPanel>

                                        <TextBlock Text="文件不存在或加载失败时自动降级为纯色背景。"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <!-- 自动执行 -->
                            <Border Classes="pane-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="自动执行" Classes="pane-card-title" />
                                    <CheckBox x:Name="CountdownEnabledCheck"
                                              Content="启用倒计时（到时按指定按钮自动执行）"
                                              IsChecked="{Binding Settings.IsAutoExecuteEnabled, Mode=TwoWay}" />
                                    <StackPanel Spacing="8"
                                                IsEnabled="{Binding #CountdownEnabledCheck.IsChecked}">
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                                <TextBlock Text="时长（秒）" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <controls:FANumberBox MinWidth="120"
                                                                       SpinButtonPlacementMode="Inline"
                                                                       Minimum="0" Maximum="3600"
                                                                       SmallChange="1" LargeChange="5"
                                                                       Value="{Binding Settings.AutoExecuteSeconds, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                                <TextBlock Text="进度条样式" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ComboBox x:Name="CountdownBarStyleBox" HorizontalAlignment="Stretch"
                                                          SelectedIndex="{Binding Settings.CountdownBarStyleIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="线性条（主提示下方）" Tag="line" />
                                                    <ComboBoxItem Content="环形" Tag="circle" />
                                                    <ComboBoxItem Content="隐藏" Tag="none" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <!-- 自动执行与「窗口关闭」共用同一目标按钮，只保留这一个选择器 -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="自动执行 / 关闭时执行的按钮" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Settings.AutoExecuteTargets}"
                                                  SelectedIndex="{Binding Settings.AutoExecuteTargetIndex, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:AutoExecuteTarget">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="到时自动执行，或点标题栏 X 关闭时，都按此按钮处理；选择「无事发生」则仅关闭弹窗。"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 窗口关闭 -->
                            <Border Classes="pane-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="窗口关闭" Classes="pane-card-title" />
                                    <CheckBox x:Name="ClosableCheck"
                                              Content="窗口可直接关闭（标题栏 X 按钮可用）"
                                              IsChecked="{Binding Settings.IsClosable, Mode=TwoWay}" />
                                    <TextBlock Margin="24,0,0,0" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Text="关闭时按上方「自动执行 / 关闭时执行的按钮」处理；选择「无事发生」则仅关闭弹窗。" />
                                </StackPanel>
                            </Border>

                            <!-- 弹窗行为 -->
                            <Border Classes="pane-card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="弹窗行为" Classes="pane-card-title" />
                                    <CheckBox Content="置顶（弹窗始终位于最上层）"
                                              IsChecked="{Binding Settings.IsTopmost, Mode=TwoWay}" />
                                    <CheckBox Content="提示文本按 Markdown 渲染（关闭后以纯文本显示）"
                                              IsChecked="{Binding Settings.IsMarkdownRendered, Mode=TwoWay}" />
                                    <CheckBox Content="交互融合（贴合主界面覆盖层显示，而非独立窗口）"
                                              IsChecked="{Binding Settings.IsInteractiveFusion, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- 窗口大小 -->
                            <Border Classes="pane-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="窗口大小" Classes="pane-card-title" />
                                    <CheckBox x:Name="CustomSizeCheck"
                                              Content="强制使用自定义窗口大小"
                                              IsChecked="{Binding Settings.UseCustomWindowSize, Mode=TwoWay}" />
                                    <Grid ColumnDefinitions="*,*" IsEnabled="{Binding #CustomSizeCheck.IsChecked}">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                            <TextBlock Text="宽度（DIP）" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <controls:FANumberBox MinWidth="120"
                                                                  SpinButtonPlacementMode="Inline"
                                                                  Minimum="360" Maximum="7680"
                                                                  SmallChange="10" LargeChange="100"
                                                                  Value="{Binding Settings.CustomWindowWidth, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                            <TextBlock Text="高度（DIP）" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <controls:FANumberBox MinWidth="120"
                                                                  SpinButtonPlacementMode="Inline"
                                                                  Minimum="220" Maximum="4320"
                                                                  SmallChange="10" LargeChange="100"
                                                                  Value="{Binding Settings.CustomWindowHeight, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="24,0,0,0" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Text="关闭时沿用默认 500×280 并可自由缩放；交互融合模式始终贴合主界面。" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ======== 中间：按钮列表 ======== -->
            <Border Grid.Column="1"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12,10,12,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <ci:FluentIcon Glyph="{x:Static icons:FluentIcons.TextBulletListRegular}" FontSize="14"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="按钮列表"
                                           FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       x:Name="ButtonCountLabel"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="10,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="6">
                            <Button Classes="toolbar-btn"
                                    Click="OnAddButtonClick"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ci:FluentIcon Glyph="{x:Static icons:FluentIcons.AddFilled}" FontSize="13" />
                                    <TextBlock Text="新建按钮" />
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="SearchBox" Watermark="搜索按钮名..."
                                     TextChanged="OnSearchTextChanged" />
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="ButtonList"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="OnButtonListSelectionChanged"
                             DragDrop.AllowDrop="True"
                             DragDrop.DragOver="OnButtonListDragOver"
                             DragDrop.Drop="OnButtonListDrop">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:MultiButtonPromptButton">
                                <Border Classes="button-row"
                                        Tag="{Binding}"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragOver="OnButtonItemDragOver"
                                        DragDrop.Drop="OnButtonItemDrop">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                        <controls:FAIconSourceElement Grid.Column="0"
                                                                     IconSource="{Binding IconSource}"
                                                                     Width="14" Height="14"
                                                                     Classes="repair-fontsize"
                                                                     TextElement.FontSize="14"
                                                                     VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Classes="drag-grip"
                                                Tag="{Binding}"
                                                Margin="8,0,8,0"
                                                PointerPressed="OnButtonDragHandlePressed"
                                                PointerMoved="OnButtonDragHandleMoved"
                                                PointerReleased="OnButtonDragHandleReleased"
                                                ToolTip.Tip="按住拖动以排序">
                                            <TextBlock Text="⋮⋮"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Actions.ActionItems.Count, StringFormat={}{0} actions}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ======== 右侧：按钮详情面板 ======== -->
            <Grid Grid.Column="2">
                <!-- 空状态：覆盖整个右侧区域居中显示，选中按钮后隐藏 -->
                <Grid x:Name="PlaceholderView"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <ci:FluentIcon Glyph="{x:Static icons:FluentIcons.CursorClickRegular}" FontSize="42"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                        <TextBlock Text="从中间选择一个按钮" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="或在中间顶部「新建按钮」" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 详情表单 -->
                <ScrollViewer x:Name="DetailView" IsVisible="False" Padding="16">
                    <StackPanel Spacing="12">
                        <Border Classes="pane-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="按钮基础信息" Classes="pane-card-title" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBox Grid.Row="0" Grid.Column="0"
                                             Watermark="按钮名称"
                                             Text="{Binding ActiveButton.Name, Mode=TwoWay}" />
                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                Orientation="Horizontal" Spacing="4" Margin="6,0,0,0">
                                        <ui:IconExpressionEditor
                                            VerticalAlignment="Center"
                                            IconExpression="{Binding ActiveButton.Icon, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 外观：强调样式（学习 ClassIsland 倒计时组件的"强调色"设置）
                             三种模式：默认（无强调） / 高亮（系统蓝色） / 自定义（用户选色） -->
                        <Border Classes="pane-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="外观" Classes="pane-card-title" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="强调样式" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ComboBox HorizontalAlignment="Stretch"
                                              SelectedIndex="{Binding ActiveButton.AccentMode, Mode=TwoWay}">
                                        <ComboBoxItem Content="默认（跟随主题）" />
                                        <ComboBoxItem Content="高亮（系统蓝色）" />
                                        <ComboBoxItem Content="自定义颜色" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding ActiveButton.AccentMode, Converter={x:Static converters:EnumEqualsConverter.Instance}, ConverterParameter=Custom}">
                                    <TextBlock Text="自定义颜色" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ColorPicker Color="{Binding ActiveButton.CustomColor, Mode=TwoWay}"
                                                  IsAlphaEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 交互倒计时：
                             启用后弹窗打开时该按钮即被锁定 N 秒（呈暗淡禁用态并显示剩余秒数），
                             倒计时结束才可点击，点击后才执行其 Action 链；不会自动执行 Action。
                             仅启用了交互倒计时的按钮受影响，其它按钮弹窗打开即可点击。
                             若需到时间自动执行，请用左侧"自动执行"） -->
                        <Border Classes="pane-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="交互倒计时" Classes="pane-card-title" />
                                <CheckBox x:Name="ButtonCountdownEnabledCheck"
                                          Content="启用交互倒计时（该按钮禁用 N 秒后才可点击）"
                                          IsChecked="{Binding ActiveButton.IsCountdownEnabled, Mode=TwoWay}" />
                                <StackPanel Spacing="4" Margin="24,0,0,0"
                                            IsEnabled="{Binding #ButtonCountdownEnabledCheck.IsChecked}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="禁用时长（秒）" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <controls:FANumberBox MinWidth="120"
                                                                   SpinButtonPlacementMode="Inline"
                                                                   Minimum="0" Maximum="60"
                                                                   SmallChange="1" LargeChange="5"
                                                                   Value="{Binding ActiveButton.CountdownSeconds, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="仅锁定本按钮，倒计时期间按钮呈禁用态并显示剩余秒数，不会自动执行 Action。"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 操作验证（调用 ClassIsland 的 AuthorizeService：
                             启用后按下按钮执行其 Action 链前，先进行身份验证） -->
                        <Border Classes="pane-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="操作验证" Classes="pane-card-title" />
                                <CheckBox x:Name="OperationVerificationCheck"
                                          Content="启用操作验证（执行前进行身份验证）"
                                          IsChecked="{Binding ActiveButton.IsOperationVerification, Mode=TwoWay}" />
                                <StackPanel Spacing="6" Margin="24,0,0,0"
                                            IsEnabled="{Binding ActiveButton.IsOperationVerification}">
                                    <TextBlock Text="凭据状态" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding ActiveButton.VerificationStatusText}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <Button Content="配置/修改凭据…"
                                                FontSize="12"
                                                Click="OnConfigureVerificationClick"
                                                ToolTip.Tip="创建或修改本按钮使用的身份验证方式（密码等）。" />
                                    </StackPanel>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Text="需先在 ClassIsland 中配置认证方式（如密码），再在这里创建或修改凭据。" />
                                    <TextBlock Text="验证失败时" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ComboBox HorizontalAlignment="Stretch"
                                              SelectedIndex="{Binding ActiveButton.VerificationFailureBehavior, Mode=TwoWay}">
                                        <ComboBoxItem Content="不执行，弹窗保持打开" />
                                        <ComboBoxItem Content="不执行，并关闭弹窗" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="pane-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Action 链（按下按钮后依次执行）" Classes="pane-card-title" />
                                <core:ActionControl ActionSet="{Binding ActiveButton.Actions}" />
                            </StackPanel>
                        </Border>

                        <Button Classes="toolbar-btn"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                HorizontalAlignment="Right"
                                Click="OnDeleteButtonClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ci:FluentIcon Glyph="{x:Static icons:FluentIcons.DeleteRegular}" FontSize="13" />
                                <TextBlock Text="删除该按钮" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</ci:MyWindow>
