<UserControl x:Class="InquiryWindow.Views.InquiryWindowDialogContent"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:converters="clr-namespace:InquiryWindow.Converters"
             xmlns:vm="clr-namespace:InquiryWindow.Views"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:helpers="clr-namespace:ClassIsland.Core.Helpers;assembly=ClassIsland.Core"
             x:DataType="vm:InquiryWindowWindow+ViewModel">

    <!--
        「询问窗」弹窗内容（桌面版「交互融合」覆盖窗口专用）。
        从 InquiryWindowWindow.axaml 抽取出来，供 InquiryWindowFusionOverlay 承载，
        使询问内容可以融合到 ClassIsland 主界面覆盖层显示（而非独立窗口）。
        按钮点击通过 ResultChosen 事件通知宿主关闭并返回结果。
    -->
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassIsland.Core/Themes/RichTextStyles.axaml" />
    </UserControl.Styles>

    <Border Padding="16" CornerRadius="8"
            Background="{DynamicResource LayerFillColorAltBrush}">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

            <!-- 弹窗标题小字 -->
            <TextBlock Grid.Row="0"
                       Text="{Binding DialogTitleSmall}"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8" />

            <!-- 主标题 + 图标 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                <Image Source="{Binding Icon}"
                       Width="32" Height="32"
                       IsVisible="{Binding IsIconVisible}" />
                <TextBlock Text="{Binding DialogTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 正文（Markdown 渲染，仅上下滚动；高度由外层 * 行约束，写法与 SystemTools 一致）
                 前景色统一取主题 TextFillColorPrimaryBrush，随主题（亮/暗）自动切换。 -->
            <mdxaml:MarkdownScrollViewer Grid.Row="2"
                                          Engine="{x:Static helpers:MarkdownConvertHelper.Engine}"
                                          Markdown="{Binding DialogBody}"
                                          TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <!-- 路径预览 -->
            <TextBlock Grid.Row="3"
                       Text="{Binding PathText}"
                       FontFamily="Consolas, Menlo, monospace"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsPathVisible}"
                       Margin="0,8,0,8" />

            <!-- 倒计时（文本 + 进度条） -->
            <Border Grid.Row="4"
                    Padding="12"
                    CornerRadius="6"
                    IsVisible="{Binding IsAutoExecuteActive}"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                    Margin="0,0,0,8">
                <Panel>
                    <!-- 进度条样式由「进度条样式」设置决定：0=线性条 / 1=环形 / 2=隐藏，倒计时文字始终显示 -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsLineProgressStyle}">
                        <TextBlock Text="{Binding CountdownText}"
                                   FontSize="14"
                                   FontWeight="DemiBold" />
                        <ProgressBar Height="5"
                                     Minimum="0"
                                     Maximum="{Binding AutoExecuteMaxSeconds}"
                                     Value="{Binding AutoExecuteRemainingSeconds}"
                                     Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsRingProgressStyle}">
                        <!-- 环形（Ellipse 背景环 + Path 进度弧，样式参照本体 CountDownComponent） -->
                        <Panel Width="22" Height="22" VerticalAlignment="Center">
                            <Ellipse Width="21.4" Height="21.4"
                                     Stroke="{DynamicResource ControlStrongStrokeColorDisabledBrush}"
                                     StrokeThickness="2.6"
                                     VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Path Width="22" Height="22"
                                  Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                  StrokeThickness="3.1"
                                  StrokeLineCap="Round"
                                  VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path.Data>
                                    <MultiBinding Converter="{x:Static converters:RingProgressGeometryConverter.Instance}">
                                        <Binding Path="AutoExecuteRemainingSeconds" />
                                        <Binding Path="AutoExecuteMaxSeconds" />
                                    </MultiBinding>
                                </Path.Data>
                            </Path>
                        </Panel>
                        <TextBlock Text="{Binding CountdownText}"
                                   FontSize="14"
                                   FontWeight="DemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding CountdownText}"
                               FontSize="14"
                               FontWeight="DemiBold"
                               IsVisible="{Binding IsNoneProgressStyle}" />
                </Panel>
            </Border>

            <!-- 按钮区：实际模式「取消」+「执行」；预览模式「看完了」 -->
            <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto,Auto">
                <Button Grid.Column="1"
                        Content="取消"
                        MinWidth="84"
                        Height="33"
                        Margin="0,0,8,0"
                        IsVisible="{Binding !IsPreviewMode}"
                        Click="OnCancelClick" />
                <Button Grid.Column="2"
                        Content="执行"
                        Classes="accent"
                        IsDefault="True"
                        MinWidth="84"
                        Height="33"
                        IsEnabled="{Binding CanExecute}"
                        IsVisible="{Binding !IsPreviewMode}"
                        Click="OnExecuteClick" />
                <Button Grid.Column="3"
                        Content="看完了"
                        Classes="accent"
                        IsDefault="True"
                        MinWidth="84"
                        Height="33"
                        IsVisible="{Binding IsPreviewMode}"
                        Click="OnAcknowledgeClick" />
            </Grid>

        </Grid>
    </Border>
</UserControl>