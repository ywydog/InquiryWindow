<ci:MyWindow x:Class="InquiryWindow.Views.InquiryWindowWindow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:local="clr-namespace:InquiryWindow.Views"
             xmlns:vm="clr-namespace:InquiryWindow.Views"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:helpers="clr-namespace:ClassIsland.Core.Helpers;assembly=ClassIsland.Core"
             x:DataType="vm:InquiryWindowWindow+ViewModel"
             Width="500" Height="240"
             MinHeight="200"
             WindowStartupLocation="CenterScreen"
             CanResize="False"
             Topmost="True"
             ShowAsDialog="True">

    <ci:MyWindow.Styles>
        <!-- ClassIsland 自带的 Markdown 主题，让弹窗和系统设置/更新日志风格一致 -->
        <StyleInclude Source="avares://ClassIsland.Core/Themes/RichTextStyles.axaml" />
    </ci:MyWindow.Styles>

    <!--
        内容根 Border：默认背景为 LayerFillColorAltBrush（纯色）。
        当 IsAcrylicActive 为 true 时，code-behind 会把窗口设为 AcrylicBlur + 透明，
        并把本 Border 的背景换成不透明度可调的系统画刷（亚克力色）。
        通过给 Border 命名让 code-behind 可以拿到它改 Background / Opacity。
    -->
    <Border x:Name="ContentRoot"
            Padding="16" CornerRadius="8"
            Background="{DynamicResource LayerFillColorAltBrush}">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8">

            <!-- 弹窗标题小字（窗口内顶部） -->
            <TextBlock Grid.Row="0"
                       Text="{Binding DialogTitleSmall}"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- 主标题 + 图标（图标的可见性由 ShowIcon 控制） -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                <Image Source="{Binding Icon}"
                       Width="32" Height="32"
                       IsVisible="{Binding IsIconVisible}" />
                <TextBlock Text="{Binding DialogTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 正文（Markdown 渲染：仅上下滚动，横向强制关闭） -->
            <mdxaml:MarkdownScrollViewer Grid.Row="2"
                                          Engine="{x:Static helpers:MarkdownConvertHelper.Engine}"
                                          Markdown="{Binding DialogBody}"
                                          MinHeight="40"
                                          MaxHeight="320"
                                          VerticalAlignment="Top" />

            <!-- 路径预览（独立一行，可见性由 ShowPath 控制） -->
            <TextBlock Grid.Row="3"
                       Text="{Binding PathText}"
                       FontFamily="Consolas, Menlo, monospace"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsPathVisible}" />

            <!-- 倒计时（文本 + 进度条），仅在自动执行启用时显示 -->
            <Border Grid.Row="4"
                    Padding="12"
                    CornerRadius="6"
                    IsVisible="{Binding IsAutoExecuteActive}"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding CountdownText}"
                               FontSize="14"
                               FontWeight="DemiBold" />
                    <ProgressBar Height="5"
                                 Minimum="0"
                                 Maximum="{Binding AutoExecuteMaxSeconds}"
                                 Value="{Binding AutoExecuteRemainingSeconds}">
                        <ProgressBar.Styles>
                            <Style Selector="ProgressBar">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Style>
                        </ProgressBar.Styles>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <!--
                按钮区：根据 IsPreviewMode 切换。
                  - 实际模式（默认）：「取消」+「执行」。
                  - 预览模式：只显示「看完了」按钮（不触发任何后续动作，仅关闭弹窗）。
                预览模式用于设置页调试亚克力 / 透明度，无需配置目标路径。
            -->
            <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto,Auto">
                <Button Grid.Column="1"
                        x:Name="CancelButton"
                        Content="取消"
                        MinWidth="84"
                        Height="33"
                        Margin="0,0,8,0"
                        IsVisible="{Binding !IsPreviewMode}"
                        Click="OnCancelClick" />
                <Button Grid.Column="2"
                        x:Name="ExecuteButton"
                        Content="执行"
                        Classes="accent"
                        IsDefault="True"
                        MinWidth="84"
                        Height="33"
                        IsEnabled="{Binding CanExecute}"
                        IsVisible="{Binding !IsPreviewMode}"
                        Click="OnExecuteClick" />
                <Button Grid.Column="3"
                        x:Name="AcknowledgeButton"
                        Content="看完了"
                        Classes="accent"
                        IsDefault="True"
                        MinWidth="84"
                        Height="33"
                        IsVisible="{Binding IsPreviewMode}"
                        Click="OnAcknowledgeClick" />
            </Grid>

        </Grid>
    </Border>
</ci:MyWindow>
